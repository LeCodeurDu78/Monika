# Copie ce fichier en .env puis adapte les valeurs.

# --- LLM (API compatible OpenAI) ---
LLM_BASE_URL=https://api.libertai.io/v1
OPENAI_API_KEY=
MODEL_NAME=deepseek-v4.1-flash
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2

# --- Stockage (mémoire, voix, RAG, journaux) ---
MONIKA_HOME=~/.config/monika

# --- Serveurs MCP (outils) ---
# Fichier par défaut : ~/.config/monika/mcp_servers.json (modèle : mcp_servers.example.json)
# MCP_SERVERS_FILE=
MCP_START_TIMEOUT_S=30
MCP_CALL_TIMEOUT_S=120

# --- Agent ---
MAX_STEPS=100
# Même appel + même résultat : avertissement à la n-ième fois, arrêt avec bilan à la m-ième
LOOP_WARN_AFTER=3
LOOP_STOP_AFTER=5
# Phrase d'attente dite si un outil « lent » dépasse ce délai (secondes), max par tour
FILLER_DELAY_S=1.5
FILLER_REPEAT_S=8
FILLER_MAX_PER_TURN=2

# --- Contexte (les tokens sont estimés, pas comptés exactement) ---
# deepseek-v4.1-flash : fenêtre de 1 M de tokens. Le budget est le seuil qui déclenche le résumé
# automatique des anciens échanges ; garde-le bien en dessous de la fenêtre (coût, vitesse, qualité).
CONTEXT_WINDOW_TOKENS=1000000
CONTEXT_BUDGET_TOKENS=150000
CONTEXT_KEEP_RECENT_TOKENS=40000
# Résultat d'outil plus long : tronqué, texte complet sauvegardé dans ~/.config/monika/tool_results
TOOL_RESULT_MAX_CHARS=20000
TOOL_RESULTS_KEEP_DAYS=14

# --- Mémoire rapide (mem0 + Qdrant local) : faits et préférences sur toi ---
FAST_MEMORY_ENABLED=true
# Embeddings calculés en local sur le CPU (téléchargés au premier lancement, ~1 Go).
# Plus léger : sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (0,2 Go)
# Si tu changes de modèle, supprime ~/.config/monika/memory/qdrant (dimensions différentes).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Modèle qui extrait les faits des conversations (vide = MODEL_NAME) ; un modèle moins cher suffit
MEMORY_LLM_MODEL=
# Tant que la mémoire contient au plus ce nombre de faits, ils sont TOUS injectés dans chaque
# message ; au-delà, seuls les plus pertinents (RECALL_LIMIT, au-dessus du seuil). 0 = toujours par pertinence.
MEMORY_INJECT_ALL_MAX=30
MEMORY_RECALL_LIMIT=8
MEMORY_RECALL_THRESHOLD=0.25
MEMORY_RECALL_TIMEOUT_S=5
# Capture automatique en arrière-plan après chaque échange
MEMORY_CAPTURE_ENABLED=true
MEMORY_CAPTURE_MIN_CHARS=20

# --- Documents personnels (RAG) : llama-index + Qdrant local, tout sur le CPU ---
RAG_ENABLED=true
# Dossiers à indexer, séparés par des virgules (par défaut : tout ton dossier personnel)
RAG_ROOTS=~
# Motifs supplémentaires à exclure (noms ou chemins, séparés par des virgules). Les fichiers cachés,
# les clés/.env/identifiants et node_modules, .git, caches, etc. sont déjà exclus.
RAG_EXCLUDE=
RAG_INCLUDE_HIDDEN=false
# Ce modèle lit au plus ~128 tokens : passages courts (500 caractères). Plus précis mais bien plus
# lent à indexer sur CPU : intfloat/multilingual-e5-large avec RAG_CHUNK_CHARS=1500 (puis --reset).
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
RAG_CHUNK_CHARS=500
RAG_CHUNK_OVERLAP_CHARS=80
RAG_MAX_TEXT_KB=1024
RAG_MAX_DOC_MB=50
RAG_MAX_CHUNKS_PER_FILE=5000
RAG_EMBED_BATCH=16
# Threads de calcul des embeddings pendant l'indexation (0 = la moitié des cœurs)
RAG_THREADS=0
# Recherche : candidats récupérés, résultats gardés, équilibre sens/mots-clés (1 = sens seul)
RAG_CANDIDATES=24
RAG_TOP_K=5
RAG_HYBRID_ALPHA=0.5
# Reranking (lecture fine de chaque candidat). Plus léger : BAAI/bge-reranker-v2-m3-int8
RAG_RERANK_ENABLED=true
RAG_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Filtre de pertinence : les passages dont le score du reranker est sous ce seuil sont écartés
# (uniquement quand le reranking a fonctionné). 0 écarte les passages jugés hors sujet ; monte pour
# être plus strict, -100 garde tout. Pour régler : RAG_MIN_SCORE=-100 python -m monika --rag-search ...
RAG_MIN_SCORE=0.0

# --- Reconnaissance vocale (faster-whisper + détection de fin de phrase Silero) ---
# Modèles : tiny, base, small, medium, large-v3-turbo… (small = bon compromis sur CPU ; medium est
# plus précis mais ~3x plus lent). Téléchargé au premier lancement du mode voix.
STT_MODEL=small
# auto = CPU, pour garder la VRAM à la synthèse vocale. cuda : mets STT_COMPUTE_TYPE=int8_float16
STT_DEVICE=auto
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=fr
STT_BEAM_SIZE=2
STT_CPU_THREADS=0
# Aide Whisper à bien écrire « Monika » et à rester en français
STT_PROMPT=Conversation en français avec Monika, une assistante personnelle.
# Micro : source PulseAudio/PipeWire (liste : pactl list short sources). Défaut : @DEFAULT_SOURCE@
AUDIO_INPUT_DEVICE=@DEFAULT_SOURCE@
VAD_SPEECH_THRESHOLD=0.5
# Silence qui termine une phrase : plus court = plus réactif, mais coupe si tu hésites
VAD_END_SILENCE_MS=700
VAD_MIN_SPEECH_MS=250
VAD_PRE_ROLL_MS=300
VAD_MAX_UTTERANCE_S=30
# Monika n'écoute pas pendant qu'elle parle ; délai de grâce avant de réécouter
VOICE_RESUME_DELAY_MS=400

# --- Synthèse vocale (XTTS v2 de Coqui, avec ta voix clonée) ---
# Ta voix de référence : un ou plusieurs enregistrements (.wav conseillé, 6 à 30 s, sans bruit ni
# musique) placés directement dans ~/.config/monika/voice/
TTS_ENABLED=true
# Monika parle aussi en mode texte
TTS_TEXT_MODE=true
# XTTS v2 est sous licence CPML (usage non commercial, https://coqui.ai/cpml). Le téléchargement du
# modèle (environ 1,9 Go) n'a lieu que si tu l'acceptes ici.
TTS_ACCEPT_LICENSE=false
# auto = GPU si possible (repli sur le CPU si la mémoire manque), cpu, cuda
TTS_DEVICE=auto
TTS_LANGUAGE=fr
TTS_SPEED=1.0
# Jetons générés par morceau de son : plus petit = premier son plus tôt, plus grand = lecture plus lisse
TTS_STREAM_CHUNK=20
TTS_MAX_SENTENCE_CHARS=200
# Sortie audio (liste : pactl list short sinks). Vide = sortie par défaut
AUDIO_OUTPUT_DEVICE=

# --- Page locale : avatar 3D et tableau de bord (visible depuis cet ordinateur seulement) ---
WEB_ENABLED=true
WEB_PORT=8765

# --- Personnalité ---
# Ton prénom, utilisé dans le prompt système (optionnel)
USER_NAME=

# --- Journal ---
LOG_LEVEL=INFO
AUDIT_ENABLED=true
AUDIT_MAX_CHARS=2000

# --- Personnage : émotions et relation (favorabilité), exprimées par l'avatar 3D ---
CHARACTER_ENABLED=true
# Un petit appel au modèle lit le ton de chaque message (repli sur un lexique français intégré s'il échoue ou tarde)
AFFECT_LLM_ENABLED=true
AFFECT_LLM_MODEL=
AFFECT_TIMEOUT_S=2
# Journal : Monika note ses impressions sur toi (visibles et effaçables : /journal)
JOURNAL_ENABLED=true
# Une note tous les N échanges (et à la fermeture)
JOURNAL_EVERY_TURNS=8
JOURNAL_LLM_MODEL=
# Taille maximale de la section journal dans son prompt (caractères)
JOURNAL_MAX_CHARS=1800
