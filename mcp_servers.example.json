{
  "mcpServers": {
    "fichiers": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${HOME}"],
      "slow_tools": {
        "search_files": ["Je cherche dans tes fichiers, une seconde.", "Je fouille un peu, patiente."]
      }
    },
    "exemple_http": {
      "enabled": false,
      "url": "http://127.0.0.1:8000/mcp",
      "headers": {"Authorization": "Bearer ${MON_TOKEN}"},
      "slow": true,
      "enabled_tools": ["outil_utile"]
    },
    "hermes": {
      "enabled": false,
      "command": "python",
      "args": ["-m", "bridges.helper_bridge"],
      "env": {
        "HELPER_KIND": "hermes",
        "HELPER_NAME": "Hermes",
        "HELPER_URL": "${HERMES_URL}",
        "HELPER_TOKEN": "${HERMES_TOKEN}"
      },
      "slow_tools": {"ask": ["Je passe la main à Hermes, une seconde."]}
    },
    "nanomuse": {
      "enabled": false,
      "command": "python",
      "args": ["-m", "bridges.helper_bridge"],
      "env": {
        "HELPER_KIND": "nanomuse",
        "HELPER_NAME": "nanoMuse",
        "HELPER_URL": "${NANOMUSE_URL}",
        "HELPER_TOKEN": "${NANOMUSE_TOKEN}"
      },
      "slow_tools": {"ask": ["Je demande à nanoMuse, un instant."]}
    }
  }
}
